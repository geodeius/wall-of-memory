      "html": "<div class=\"ds-modes\" role=\"group\" aria-label=\"Contribution type\"><button aria-pressed=\"true\">Write something</button><button aria-pressed=\"false\">Draw / sign</button></div>",
      "css": ".ds-modes{display:flex;padding:4px;border-radius:16px;background:#f1eaee}.ds-modes button{font-family:Inter,sans-serif;cursor:pointer;border:0;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:background-color 120ms cubic-bezier(.23,1,.32,1),scale 120ms cubic-bezier(.23,1,.32,1);flex:1;min-height:44px;border-radius:12px;background:transparent;font-size:12px;color:var(--muted,#73636e)}.ds-modes button[aria-pressed=true]{background:var(--paper,#fffdf8);color:var(--accent,#66023c);font-weight:600}.ds-modes button:hover{color:var(--accent,#66023c)}.ds-modes button:active{scale:.97}.ds-modes button:focus-visible{outline:3px solid var(--focus,#8b3670);outline-offset:4px}"
