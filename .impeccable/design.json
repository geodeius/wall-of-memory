      "css": ".ds-label{display:block;font:500 13px/1.5 Inter,sans-serif;margin-bottom:9px;color:var(--ink,#42313e)}.ds-field{font:400 16px/1.5 Inter,sans-serif;background:var(--field,#f4eff1);color:var(--ink,#42313e);border:1px solid transparent;border-radius:16px;padding:12px 14px;max-width:100%;height:100px;caret-color:var(--accent,#66023c)}.ds-field:hover{border-color:var(--line,#d8cbd3)}.ds-field:focus-visible{outline:2px solid var(--focus,#8b3670);outline-offset:2px;border-color:var(--accent,#66023c)}"
