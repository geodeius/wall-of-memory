      "css": ".ds-ink{font-family:Inter,sans-serif;cursor:pointer;border:0;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:background-color 120ms cubic-bezier(.23,1,.32,1),scale 120ms cubic-bezier(.23,1,.32,1);position:relative;isolation:isolate;width:44px;height:44px;border-radius:50%;background:transparent;color:var(--paper,#fffdf8);outline:2px solid var(--accent,#66023c);padding:0}.ds-ink:before{content:\"\";position:absolute;inset:5px;border-radius:50%;background:var(--accent,#66023c);z-index:-1}.ds-ink:hover{background:var(--accent-soft,#f0e3eb)}.ds-ink:active{scale:.97}.ds-ink:focus-visible{outline:3px solid var(--focus,#8b3670);outline-offset:4px}"
