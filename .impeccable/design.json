  "narrative": {
    "northStar": "Open Studio",
    "overview": "Open Studio pairs the original mural and warm plaster with a welcoming, expressive place to make a small contribution. Paper controls sit above the artwork; Tyrian purple gives actions a clear voice, while the plum-tinted studio header makes creation feel like a shared workbench.\n\nThe interface stays legible in Inter and leaves expressive lettering to the wall and its honest preview. Rounded forms and brief, responsive motion make controls approachable without animating the artwork or disturbing reading and drawing.",
    "keyCharacteristics": [
      "Warm plaster and preserved mural",
      "Tyrian actions on paper surfaces",
      "Inter interface with expressive wall lettering",
      "Rounded controls and functional ink swatches",
      "Direct manipulation with forgiving drafts"
    ],
    "rules": [
      {
        "name": "The Wall First Rule",
        "body": "Keep the original mural and plaster visible around interface surfaces; decorative artwork belongs on the wall.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Inter for interface text; use Caveat, DM Sans, or Georgia only for wall lettering and its preview.",
        "section": "typography"
      },
      {
        "name": "The Soft Lift Rule",
        "body": "Reserve diffuse shadows for floating dialogs, notices, and the placement marker; ordinary controls rest on paper without added elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the original mural and plaster texture.",
      "Do keep Zoom and Home pinned at bottom center and Add a mark pinned at bottom right, with safe-area spacing.",
      "Do retain the persistent publish footer while the editor body scrolls.",
      "Do provide labeled Phosphor controls, visible focus, selected-state checks, and a text alternative to drawing.",
      "Do preserve placement and draft content through errors and dismissal; clear the stored draft only after successful publishing."
    ],
    "donts": [
      "Don't move interface lettering into decorative wall fonts.",
      "Don't replace the honest preview with unrelated art or fabricated visitor content.",
      "Don't add looping decorative motion, sound, or confetti.",
      "Don't animate keyboard exploration or drawing, or hide focus to make a transition smoother."
    ]
  }
}
