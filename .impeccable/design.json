      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Tyrian publishing and Add actions.",
      "html": "<button class=\"ds-primary\">Publish your mark</button>",
      "css": ".ds-primary{font-family:Inter,sans-serif;cursor:pointer;border:0;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:background-color 120ms cubic-bezier(.23,1,.32,1),scale 120ms cubic-bezier(.23,1,.32,1);background:var(--accent,#66023c);color:var(--paper,#fffdf8);border-radius:999px;padding:14px 23px;min-height:50px;font-size:14px;font-weight:600}.ds-primary:hover{background:var(--accent-hover,#4d022d)}.ds-primary:active{scale:.97}.ds-primary:focus-visible{outline:3px solid var(--focus,#8b3670);outline-offset:4px}"
    },
