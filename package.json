{
  "name": "community-wall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node --env-file-if-exists=.env server/index.js\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
