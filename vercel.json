{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/schema.sql",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }]
}
